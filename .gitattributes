# Normalise line endings.
#
# The dev machine is Windows; every runtime target is Linux. Without this, a
# fresh clone with core.autocrlf=true rewrites docker-entrypoint.sh with CRLF,
# and the container then fails at startup with a confusing "no such file or
# directory" — the kernel reading `#!/bin/sh\r` as an interpreter path.

* text=auto eol=lf

# Files that MUST be LF regardless of platform, because Linux runs them.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
Makefile        text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# PowerShell is the one thing that genuinely wants CRLF.
*.ps1           text eol=crlf

# Binary — never touch these.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.pdf           binary

# Generated from the OpenAPI schema; collapse its diff in review but keep it
# tracked (DECISIONS.md D-016).
frontend/src/types/api.gen.ts linguist-generated=true
frontend/package-lock.json    linguist-generated=true
backend/uv.lock               linguist-generated=true
