# ---------------------------------------------------------------------------
# HAYABUSA — environment template
#
# Copy to `.env` and fill the two secrets:
#   make secrets          (or: ./make.ps1 secrets  on Windows)
# ---------------------------------------------------------------------------

APP_NAME=HAYABUSA
APP_ENV=development
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_SECRET_KEY=              # JWT signing
APP_ENCRYPTION_KEY=          # 32-byte urlsafe-base64, AES-GCM for bot tokens/API keys at rest

# Public base URL of the web tier — used to build "Open in HAYABUSA" deep links
# in Telegram messages. Must be reachable from wherever the operator reads them.
APP_PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Datastores
#
# The value below targets the `postgres` service shipped in docker-compose.yml.
# To point the containers at a Postgres running on the *host* instead, use:
#   DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:5432/hayabusa
# To run the API/worker on the host (outside Docker) use `localhost` there.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/hayabusa
REDIS_URL=redis://redis:6379/0

DEFAULT_POLL_INTERVAL_SECONDS=10800     # 3 hours
HTTP_USER_AGENT=HAYABUSA-Collector/1.0
HTTP_TIMEOUT_SECONDS=30
COLLECTOR_CONCURRENCY=8

NVD_API_KEY=                 # optional, raises NVD rate limit
GITHUB_TOKEN=                # optional, for releases/advisories

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ---------------------------------------------------------------------------
# Compose-only knobs (not read by the application itself)
# ---------------------------------------------------------------------------

# Credentials + database created by the shipped `postgres` service.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hayabusa

# Host ports. The shipped Postgres defaults to 5433 so it cannot collide with a
# dev Postgres already bound to 5432 on the host.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# Log rendering: `json` for machine-readable output, `console` for colourised
# human-readable output during local development.
LOG_LEVEL=INFO
LOG_FORMAT=json

# Comma-separated browser origins allowed to call the API directly. In the
# default deployment the browser only ever talks to nginx, which same-origin
# proxies /api, so this matters only for `make dev`-style split running.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Run `alembic upgrade head` automatically when the api container starts.
# Set to false if you prefer to gate migrations behind an explicit `make migrate`.
AUTO_MIGRATE=true
